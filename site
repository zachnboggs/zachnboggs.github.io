<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Marketing Portfolio - Your Name</title>
<style>
  body {
    font-family: Arial, sans-serif;
    margin: 0; padding: 0;
    background: #f4f4f4;
    color: #333;
  }
  header {
    background: #0073e6;
    color: white;
    padding: 20px 10%;
    text-align: center;
  }
  header h1 {
    margin: 0;
  }
  nav {
    background: #005bb5;
    padding: 10px 10%;
    text-align: center;
  }
  nav a {
    color: white;
    margin: 0 15px;
    text-decoration: none;
    font-weight: bold;
  }
  section {
    padding: 40px 10%;
    background: white;
    margin-bottom: 20px;
    border-radius: 8px;
  }
  h2 {
    border-bottom: 2px solid #0073e6;
    padding-bottom: 10px;
  }
  .projects {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }
  .project {
    background: #e9f1ff;
    border-radius: 6px;
    padding: 20px;
    flex: 1 1 300px;
  }
  footer {
    background: #222;
    color: white;
    text-align: center;
    padding: 15px 10%;
  }
  .contact-form input, .contact-form textarea {
    width: 100%;
    padding: 8px;
    margin-top: 8px;
    margin-bottom: 15px;
    border: 1px solid #ccc;
    border-radius: 4px;
  }
  .contact-form button {
    background: #0073e6;
    color: white;
    padding: 10px 18px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
  }
  .contact-form button:hover {
    background: #005bb5;
  }
</style>
</head>
<body>

<header>
  <h1>Your Name - Marketing Specialist</h1>
  <p>Helping brands grow with digital marketing</p>
</header>

<nav>
  <a href="#about">About</a>
  <a href="#services">Services</a>
  <a href="#projects">Projects</a>
  <a href="#contact">Contact</a>
</nav>

<section id="about">
  <h2>About Me</h2>
  <p>Hello! I'm Your Name, a marketing specialist with over X years of experience creating impactful campaigns that increase brand visibility and engagement.</p>
</section>

<section id="services">
  <h2>Services</h2>
  <ul>
    <li>Social Media Marketing</li>
    <li>Content Strategy & Creation</li>
    <li>SEO & SEM</li>
    <li>Email Marketing</li>
  </ul>
</section>

<section id="projects">
  <h2>Projects</h2>
  <div class="projects">
    <div class="project">
      <h3>Project 1</h3>
      <p>Developed a social media campaign that increased engagement by 50% in 3 months.</p>
    </div>
    <div class="project">
      <h3>Project 2</h3>
      <p>Created content strategy for a startup that led to a 30% boost in website traffic.</p>
    </div>
    <div class="project">
      <h3>Project 3</h3>
      <p>Managed SEO for an ecommerce store that doubled organic search revenue.</p>
    </div>
  </div>
</section>

<section id="contact">
  <h2>Contact Me</h2>
  <form class="contact-form" onsubmit="submitForm(event)">
    <input type="text" name="name" placeholder="Your name" required />
    <input type="email" name="email" placeholder="Your email" required />
    <textarea name="message" placeholder="Your message" rows="5" required></textarea>
    <button type="submit">Send</button>
  </form>
  <p id="responseMsg" style="color:green;"></p>
</section>

<footer>
  <p>© 2025 Your Name | Marketing Portfolio</p>
</footer>

<script>
  function submitForm(e) {
    e.preventDefault();
    // This is just a placeholder: form data sending requires backend or services like Formspree
    document.getElementById('responseMsg').textContent = "Thanks for your message! I'll get back to you soon.";
    e.target.reset();
  }
</script>

</body>
</html>
